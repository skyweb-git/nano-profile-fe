{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "CI=false GENERATE_SOURCEMAP=false npm run build",
  "env": {
    "CI": "false",
    "GENERATE_SOURCEMAP": "false"
  },
  "outputDirectory": "build",
  "framework": "create-react-app",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/link/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|WhatsApp|Telegram|Twitter|Slack|LinkedIn).*"
        }
      ],
      "destination": "/api/og-link?username=:username"
    },
    {
      "source": "/artist/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|WhatsApp|Telegram|Twitter|Slack|LinkedIn).*"
        }
      ],
      "destination": "/api/og-artist?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
